# ===========================================
# AutoSave / AURA — Environment Variables
# ===========================================
# Copy to .env.local and fill in values.

# ---- Network ----
# Options: mainnet-beta | devnet | testnet
# Default: mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# ---- RPC URL (recommended) ----
# Use a dedicated provider for reliability.
#
# Helius examples:
#   Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   Devnet:  https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#
# If left empty, the app falls back to the public Solana cluster URL
# for the network selected above (rate-limited).
NEXT_PUBLIC_RPC_URL=
